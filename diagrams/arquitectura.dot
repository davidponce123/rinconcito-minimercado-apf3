digraph A {
  graph [rankdir=LR, bgcolor="white", pad="0.28", nodesep="0.33", ranksep="0.65", fontname="DejaVu Sans", label="Arquitectura web MVC + DAO · Rinconcito APF3", labelloc=t, fontsize=19, fontcolor="#18582d"];
  node [shape=box, style="rounded,filled", fillcolor="#f5f9f6", color="#86b498", fontname="DejaVu Sans", fontsize=11, penwidth=1.2, margin="0.22,0.15"];
  edge [color="#799c82", arrowsize=.8, penwidth=1.3];
  browser [label="NAVEGADOR\nThymeleaf + HTML/CSS/JS", fillcolor="#e7f4eb"];
  security [label="Spring Security\nRoles · BCrypt · CSRF", fillcolor="#fdefe4", color="#eba16e"];
  mvc [label="CONTROLADORES (MVC)\nInicio · Ventas · Catálogo\nRecepción · Reportes · Administración"];
  service [label="SERVICIOS DE NEGOCIO\nCatalogService · SalesService\nReceivingService\n@Transactional + validaciones"];
  dao [label="INTERFACES DAO\nProductDao · InventoryDao\nOperationDao", fillcolor="#e7f4eb"];
  jdbc [label="JdbcTemplate\nSQL parametrizado", fillcolor="#e7f4eb"];
  db [label="POSTGRESQL\n15 tablas · PK/FK\nv_stock · v_venta_total", fillcolor="#eff3fa", color="#8aa2c9"];
  browser->security->mvc->service->dao->jdbc->db;
  test [label="TDD: JUnit 5 + Mockito\nTests de servicios", fillcolor="#fff6dc", color="#e0c17e"];
  testsink [shape=point, width=0.01, label="", color="transparent"];
  test->service [style=dashed, label="verifica", fontname="DejaVu Sans", fontsize=9];
