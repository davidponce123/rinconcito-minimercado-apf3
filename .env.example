# CONFIGURACION LOCAL - COPIA ESTE ARCHIVO COMO .env
# Usa PostgreSQL instalado en Windows (sin Docker) y una base llamada rinconcito.
# Si instalaste PostgreSQL con el usuario postgres, mantén DB_USER=postgres.
DB_URL=jdbc:postgresql://localhost:5432/rinconcito
DB_USER=postgres
DB_PASSWORD=ESCRIBE_AQUI_TU_CLAVE_LOCAL_DE_POSTGRES
ADMIN_USER=administrador
ADMIN_PASSWORD=CREA_UNA_CLAVE_SEGURA_DE_12_O_MAS_CARACTERES
